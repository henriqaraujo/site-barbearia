dist/
.angular/
**/bin/
**/obj/

.env
.env.local
# O padrao ".env" so ignora o arquivo com esse nome exato: os arquivos por ambiente precisam de linha propria.
.env.qa
.env.production
# Credenciais locais geradas para ambientes (ex.: rotacao do QA). Nunca versionar.
credenciais-*.local.txt

*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

.DS_Store
Thumbs.db

# Build artifacts generated by temporary Codex/.NET builds
artifacts/
# Resultados locais do dotnet test (--logger trx, --results-directory): nunca versionar.
TestResults/
# Dumps e backups de banco carregam dado pessoal de cliente (LGPD): nunca versionar.
*.dump
*.backup
*.sql.gz
